# Clé API Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modèle Claude utilisé pour toutes les générations
ANTHROPIC_MODEL=claude-opus-5

# Higgsfield : images IA et vidéos (plans animés DoP, avatar parlant Speak)
# https://cloud.higgsfield.ai → API keys — format KEY_ID:KEY_SECRET
HF_CREDENTIALS=
# Optionnel : modèle d'image et qualité d'animation (dop-lite, dop-turbo, dop-standard)
HIGGSFIELD_IMAGE_MODEL=flux-pro/kontext/max/text-to-image
HIGGSFIELD_DOP_MODEL=dop-turbo

# --- V2 : comptes, base de données, stockage (Supabase → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'app (pour les retours de paiement), ex. https://mon-app.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Paiement carte : Stripe (Developers → API keys / Webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Paiement Mobile Money : CinetPay (Intégrations → API) ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# --- V2 lot 2 : hébergement des pages publiées ---
# Domaine des pages publiées : nom.pages-domaine.com (ajoute le domaine wildcard *.pages-domaine.com sur Vercel)
NEXT_PUBLIC_PAGES_DOMAIN=
# Domaines personnalisés des clients (formule Business) — Vercel → Account Settings → Tokens
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
